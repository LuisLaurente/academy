NODE_ENV=development

WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001

API_PORT=3001
CORS_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://learning_os:learning_os_dev@localhost:55432/learning_os?schema=public
REDIS_URL=redis://localhost:56379
BULLMQ_PREFIX=learning-os

AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_PASSWORD_HASH_ALGORITHM=argon2id
AUTH_ARGON2_MEMORY_COST_KIB=19456
AUTH_ARGON2_TIME_COST=2
AUTH_ARGON2_PARALLELISM=1
AUTH_ARGON2_HASH_LENGTH=32
AUTH_PASSWORD_MIN_LENGTH=12
AUTH_COOKIE_ACCESS_NAME=learning_os_access
AUTH_COOKIE_REFRESH_NAME=learning_os_refresh
AUTH_COOKIE_HTTP_ONLY=true
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_PATH=/

POSTGRES_DB=learning_os
POSTGRES_USER=learning_os
POSTGRES_PASSWORD=learning_os_dev

# ── AI Provider Keys ──────────────────────────────────────────────────────────
# Requeridas para generación de contenido con IA.
# Obtén tu clave en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Modelo a usar (opciones: gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-pro)
GEMINI_MODEL=gemini-flash-latest

# Opcional — solo si usas OpenAI como proveedor alternativo
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Opcional — solo si usas Anthropic Claude como proveedor alternativo
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
