{
  "name": "@learning-os/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "lint": "eslint src prisma.config.ts --max-warnings=0",
    "lint:fix": "eslint src prisma.config.ts --fix",
    "prisma:generate": "prisma generate",
    "prisma:seed": "prisma db seed",
    "prisma:validate": "prisma validate",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@learning-os/configuration": "workspace:*",
    "@learning-os/server": "workspace:*",
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/swagger": "11.4.6",
    "@nestjs/terminus": "11.1.1",
    "@prisma/adapter-pg": "7.9.0",
    "@prisma/client": "7.9.0",
    "bullmq": "5.80.9",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "pg": "8.22.0",
    "prisma": "7.9.0",
    "redis": "6.1.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.1.28",
    "@types/node": "26.1.1",
    "@types/pg": "8.20.0",
    "ts-loader": "9.6.2",
    "tsx": "4.19.3",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
