{
  "name": "@learning-os/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./domain": {
      "types": "./dist/domain/index.d.ts",
      "default": "./dist/domain/index.js"
    },
    "./authentication": {
      "types": "./dist/modules/identity-access/authentication/index.d.ts",
      "default": "./dist/modules/identity-access/authentication/index.js"
    },
    "./curriculum": {
      "types": "./dist/modules/curriculum/index.d.ts",
      "default": "./dist/modules/curriculum/index.js"
    },
    "./exercises": {
      "types": "./dist/modules/exercises/index.d.ts",
      "default": "./dist/modules/exercises/index.js"
    },
    "./evaluation": {
      "types": "./dist/modules/evaluation/index.d.ts",
      "default": "./dist/modules/evaluation/index.js"
    },
    "./learning": {
      "types": "./dist/modules/learning/index.d.ts",
      "default": "./dist/modules/learning/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src --max-warnings=0",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@nestjs/common": "11.1.28",
    "argon2": "0.45.0"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@vitest/coverage-v8": "4.1.10",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0"
  }
}
